{
  "name": "x-unrepost",
  "version": "0.1.0",
  "description": "Scan your X account, label posts against your own criteria with an LLM, and delete the matches.",
  "author": "Cyrus Khiabani (@cyjkcodes)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cykj40/x-unrepost.git"
  },
  "homepage": "https://github.com/cykj40/x-unrepost#readme",
  "bugs": {
    "url": "https://github.com/cykj40/x-unrepost/issues"
  },
  "keywords": [
    "x",
    "twitter",
    "cleanup",
    "delete-posts",
    "llm",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "scan": "tsx src/cli.ts scan",
    "classify": "tsx src/cli.ts classify",
    "review": "tsx src/cli.ts review",
    "delete": "tsx src/cli.ts delete",
    "status": "tsx src/cli.ts status",
    "verify": "tsx src/cli.ts verify",
    "auth": "tsx src/cli.ts auth",
    "init": "tsx src/cli.ts init"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "x-unrepost": "dist/cli.js"
  },
  "files": [
    "dist",
    ".env.example",
    "scrub.config.example.json",
    "scrub.presets.json",
    "README.md",
    "LICENSE"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
